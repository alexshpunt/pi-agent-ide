    {
      "name": "stage",
      "namespace": "ide_git",
      "exposure": "deferred",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "pattern": "^CHANGE#[0-9A-F]{4,64}$",
            "type": "string"
          },
          "file": {
            "type": "string"
          }
        },
        "required": ["file", "change"],
        "type": "object"
      }
    },
    {
      "name": "undo",
      "namespace": "ide_edit",
      "exposure": "direct",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "pattern": "^(?:CHANGE#[0-9A-F]{4,64}|last)$",
            "type": "string"
          },
          "file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          }
        },
        "required": ["change"],
        "type": "object"
      }
    },
