    {
      "name": "write",
      "namespace": "ide_edit",
      "exposure": "direct",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "properties": {
                  "data": {
                    "type": "string"
                  },
                  "mimeType": {
                    "type": "string"
                  },
                  "type": {
                    "const": "image",
                    "type": "string"
                  }
                },
                "required": ["type", "data", "mimeType"],
                "type": "object"
              },
              {
                "properties": {
                  "images": {
                    "items": {
                      "properties": {
                        "data": {
                          "type": "string"
                        },
                        "mimeType": {
                          "type": "string"
                        }
                      },
                      "required": ["data", "mimeType"],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "type": {
                    "const": "images",
                    "type": "string"
                  }
                },
                "required": ["type", "images"],
                "type": "object"
              }
            ]
          },
          "path": {
