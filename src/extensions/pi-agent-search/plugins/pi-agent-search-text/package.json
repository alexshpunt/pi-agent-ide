{
  "name": "pi-agent-search-text",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./search-session": {
      "types": "./src/search-session.ts",
      "default": "./src/search-session.ts"
    },
    "./rendering": {
      "types": "./src/search-renderer.ts",
      "default": "./src/search-renderer.ts"
    },
    "./result": {
      "types": "./src/search-result.ts",
      "default": "./src/search-result.ts"
    }
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "pi-agent-doctor": "workspace:^",
    "pi-agent-invariant": "workspace:^",
    "pi-agent-search": "workspace:^",
    "pi-agent-text": "workspace:^",
    "pi-agent-text-editor": "workspace:^"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
