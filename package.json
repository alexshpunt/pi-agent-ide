    "developer-tools",
    "diagnostics",
    "diff",
    "editor-tools",
    "formatter",
    "git",
    "guarded-editing",
    "ide",
    "image-analysis",
    "image-processing",
    "jq",
    "json",
    "language-server",
    "language-server-protocol",
    "linter",
    "lsp",
    "nodejs",
    "observability",
    "pdf",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
