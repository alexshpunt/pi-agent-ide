{
  "name": "pi-agent-unity",
  "version": "0.1.0",
  "private": true,
  "description": "Project-targeted Unity tools for Pi",
  "keywords": [
    "mcp",
    "pi-package",
    "unity"
  ],
  "homepage": "https://github.com/alexshpunt/pi-agent-ide/tree/main/integrations/unity#readme",
  "bugs": {
    "url": "https://github.com/alexshpunt/pi-agent-ide/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexshpunt/pi-agent-ide.git",
    "directory": "integrations/unity"
  },
  "files": [
    "src",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#unity/*": "./src/*",
    "#unity-tests/*": "./tests/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:node": "node --test tests/target.test.ts tests/search.test.ts tests/catalog.test.ts tests/remote.test.ts tests/remote-backend.test.ts tests/discovery.test.ts tests/cli-detection.test.ts tests/install.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "pi-agent-ide": "workspace:^1.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "pi-coding-agent-test": "0.1.8",
    "typebox": "1.3.27",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
