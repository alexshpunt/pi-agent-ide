    "graphql": "17.0.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@toon-format/toon-v4": "npm:@toon-format/toon@4.4.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.25.12",
    "typebox": "1.3.27",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24"
  }
