{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "pi-coding-agent-test": ["./tests/integration/support/pi-runtime/pi-coding-agent-test.ts"]
    },
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  },
  "include": [
    "dev/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/backend/web-browser-worker.mjs",
    "tests/**/*.ts"
  ],
  "exclude": [".worktrees/**", "**/dist/**", "**/node_modules/**"]
}
